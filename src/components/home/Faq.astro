---
// FAQ de l'accueil (extrait du §8). Accordéon en <details> / <summary> :
// accessible au clavier et aux lecteurs d'écran sans aucun script, et
// ouvert à la recherche du navigateur. Seuls le signe + (rotation) et
// l'apparition de la réponse (opacité) sont animés.
import { BETA_PATH } from "../../lib/links";
import { NAIVE, SETTLEMENTS } from "../../lib/weekend";

const faq = [
  {
    q: "C'est vraiment gratuit ? Y aura-t-il de la pub ?",
    a: [
      "Oui. Créer des groupes, inviter tes amis, ajouter des dépenses, se rembourser, discuter et décrocher des trophées : tout cela est gratuit, sans limite. Et il n'y a aucune publicité dans Braiz.",
      "Un kit de l'organisateur, avec des outils en plus, est à venir en option.",
    ],
  },
  {
    q: "Comment rejoindre la beta ?",
    a: [
      "Sur iPhone, Braiz s'installe avec TestFlight, l'app de test d'Apple. Sur Android, en téléchargeant l'application depuis la page de la beta.",
    ],
    link: { href: BETA_PATH, label: "Voir les étapes pour rejoindre la beta" },
  },
  {
    q: "Mes amis doivent-ils tous installer l'app ?",
    a: [
      "Oui : chaque membre rejoint le groupe depuis l'app, avec le lien d'invitation que tu lui envoies. C'est gratuit, et c'est ce qui permet à chacun de suivre ses soldes et de participer au chat.",
    ],
  },
  {
    q: "Comment Braiz calcule qui doit combien à qui ?",
    a: [
      `Braiz additionne ce que chaque personne a payé et ce qu'elle doit, puis compense les dettes entre elles pour proposer le moins de virements possible. Dans l'exemple du week-end plus haut, ${NAIVE.length} virements deviennent ${SETTLEMENTS.length}.`,
    ],
  },
  {
    q: "Comment se rembourser ? Qui voit mon IBAN ?",
    a: [
      "Tu fais le virement depuis ta banque, avec l'IBAN que la personne a ajouté dans Braiz, puis tu indiques dans l'app que c'est réglé. L'argent ne passe jamais par Braiz.",
      "Ton IBAN n'est visible que par les personnes qui partagent un groupe avec toi.",
    ],
  },
  {
    q: "Ton groupe utilise déjà une autre app ?",
    a: [
      "Tu peux commencer ton prochain voyage ou ta prochaine coloc sur Braiz, sans rien perdre de tes anciens comptes.",
    ],
  },
];
---
<section class="faq" aria-labelledby="faq-title">
  <div class="wrap faq__grid">
    <h2 class="faq__title" id="faq-title" data-split-title>Questions fréquentes.</h2>
    <div class="faq__list">
      {faq.map((item) => (
        <details class="faq__item">
          <summary>
            <span>{item.q}</span>
            <span class="faq__plus" aria-hidden="true"></span>
          </summary>
          <div class="faq__a">
            {item.a.map((p) => <p>{p}</p>)}
            {item.link && <p><a href={item.link.href}>{item.link.label}</a></p>}
          </div>
        </details>
      ))}
      <p class="faq__more">
        Tes données : tout est expliqué dans la <a href="/confidentialite">politique de confidentialité</a>.
      </p>
    </div>
  </div>
</section>

<style>
  .faq { padding: var(--section-y) 0; }
  .faq__grid { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: var(--s-8); align-items: start; }
  .faq__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.4rem, 1.2rem + 4.4vw, 5.2rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .faq__list { border-top: 1px solid var(--hairline); }
  .faq__item { border-bottom: 1px solid var(--hairline); }
  .faq__item summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--s-5);
    min-height: 64px;
    padding: var(--s-4) 0;
    cursor: pointer;
    list-style: none;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.1rem, 1rem + 0.5vw, 1.35rem);
    line-height: 1.25;
  }
  .faq__item summary::-webkit-details-marker { display: none; }
  .faq__plus { position: relative; flex: none; width: 28px; height: 28px; border-radius: 50%; box-shadow: inset 0 0 0 1.5px var(--outline); transition: transform var(--dur) var(--ease-spring); }
  .faq__plus::before,
  .faq__plus::after { content: ""; position: absolute; left: 50%; top: 50%; width: 12px; height: 2px; translate: -50% -50%; border-radius: 1px; background: var(--cream); }
  .faq__plus::after { rotate: 90deg; }
  .faq__item[open] .faq__plus { transform: rotate(45deg); }
  .faq__a { padding: 0 var(--s-7) var(--s-5) 0; color: var(--muted); }
  .faq__a p { margin: 0 0 var(--s-3); }
  .faq__a a, .faq__more a { color: var(--cream); text-underline-offset: 3px; }
  .faq__more { margin: var(--s-5) 0 0; color: var(--muted); font-size: var(--t-small); }

  @media (prefers-reduced-motion: no-preference) {
    .faq__item[open] .faq__a { animation: faq-in 380ms var(--ease-out) both; }
  }
  @keyframes faq-in {
    from { opacity: 0; transform: translate3d(0, -8px, 0); }
    to   { opacity: 1; transform: none; }
  }
  @media (prefers-reduced-motion: reduce) { .faq__plus { transition: none; } }

  @media (max-width: 899px) {
    .faq__grid { grid-template-columns: 1fr; gap: var(--s-6); }
    .faq__a { padding-right: 0; }
  }
</style>
