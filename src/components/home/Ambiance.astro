---
// L'ambiance : une courte conversation où arrivent de vrais messages
// système de l'app (textes exacts, lib/systemMessages.ts), puis une rangée
// de trophées (PNG de l'app en WebP / AVIF).
// home.ts fait arriver les messages avec un rebond, puis les réactions ;
// les trophées s'inclinent sous le pointeur (±12°, charte). Sans script,
// la conversation est complète et les trophées sont droits.
import { friend } from "../../lib/weekend";
import { deletionDisparu, trophyPompier } from "../../lib/systemMessages";

const deletion = deletionDisparu("Hugo", "Glaces et cafés", 78.2);
const pompier = trophyPompier("Inès");

type Line =
  | { type: "msg"; who: string; text: string }
  | { type: "sys"; emoji: string; text: string; reactions: [string, number][] };

const lines: Line[] = [
  { type: "msg", who: "lea", text: "Quelqu'un a vu passer les glaces d'hier ?" },
  { type: "sys", emoji: deletion.emoji, text: deletion.text, reactions: [["😂", 3], ["👀", 2]] },
  { type: "msg", who: "hugo", text: "Fausse manipulation, je la remets tout de suite." },
  { type: "sys", emoji: pompier.emoji, text: pompier.text, reactions: [["🔥", 4], ["👏", 2]] },
  { type: "msg", who: "sami", text: "Bravo Inès, la médaille est méritée." },
];

const trophies = [
  { key: "pompier", name: "Le Pompier" },
  { key: "genereux", name: "Le Généreux" },
  { key: "reglo", name: "Le Réglo" },
  { key: "pique-assiette", name: "Le Pique-Assiette" },
  { key: "fantome", name: "Le Fantôme" },
  { key: "ecureuil", name: "L'Écureuil" },
  { key: "roi-note", name: "Le Roi de la Note" },
  { key: "boute-en-train", name: "Le Boute-en-train" },
];
---
<section class="amb" aria-labelledby="amb-title">
  <div class="wrap amb__grid">
    <div class="amb__intro">
      <h2 class="amb__title" id="amb-title" data-split-title>Les comptes, avec l'ambiance.</h2>
      <p class="amb__text">
        Braiz annonce les trophées dans le chat du groupe et remarque tout ce
        qui disparaît des comptes. Taquin, jamais méchant.
      </p>
      <p class="amb__note">Messages tels qu'ils apparaissent dans l'app.</p>
    </div>

    <ol class="chat" aria-label="Exemple de conversation dans le chat d'un groupe">
      {lines.map((l) =>
        l.type === "msg" ? (
          <li class="chat__msg" data-chat-line>
            <span class="chat__av" style={`background:${friend(l.who).color}`} aria-hidden="true">{friend(l.who).initial}</span>
            <span class="chat__bubble"><small>{friend(l.who).name}</small>{l.text}</span>
          </li>
        ) : (
          <li class="chat__sys" data-chat-line>
            <span class="chat__emoji" aria-hidden="true">{l.emoji}</span>
            <p>{l.text}</p>
            <span class="sr-only">Réactions : {l.reactions.map(([e, n]) => `${e} ${n}`).join(", ")}.</span>
            <span class="chat__reacts" aria-hidden="true">
              {l.reactions.map(([e, n]) => (
                <span class="chat__react" data-chat-react>{e} <b>{n}</b></span>
              ))}
            </span>
          </li>
        ),
      )}
    </ol>
  </div>

  <div class="wrap trophies">
    <h3 class="trophies__title" data-split-title>Seize trophées à&nbsp;décrocher.</h3>
    <p class="trophies__text">Certains font plaisir, d'autres font rire tout le groupe.</p>
    <ul class="trophies__row">
      {trophies.map((t, i) => (
        <li class="trophy" data-trophy style={`--i: ${i}`}>
          <div class="trophy__tilt" data-trophy-tilt>
            <picture>
              <source type="image/avif" srcset={`/images/trophees/${t.key}-160.avif 160w, /images/trophees/${t.key}-320.avif 320w`} sizes="(max-width: 899px) 40vw, 150px" />
              <img
                src={`/images/trophees/${t.key}-320.webp`}
                srcset={`/images/trophees/${t.key}-160.webp 160w, /images/trophees/${t.key}-320.webp 320w`}
                sizes="(max-width: 899px) 40vw, 150px"
                width="160"
                height="160"
                alt=""
                loading="lazy"
                decoding="async"
              />
            </picture>
          </div>
          <span class="trophy__name">{t.name}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .amb { position: relative; padding: var(--section-y) 0; }
  .amb__grid {
    display: grid;
    grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
    gap: var(--s-8);
    align-items: start;
  }
  .amb__intro { position: sticky; top: 18vh; }
  .amb__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(2.4rem, 1.2rem + 4.4vw, 5.2rem);
    line-height: 0.98;
    letter-spacing: -0.035em;
    text-wrap: balance;
  }
  .amb__text { margin: var(--s-5) 0 0; max-width: 28rem; color: var(--muted); font-size: var(--t-lead); }
  .amb__note { margin: var(--s-4) 0 0; color: var(--muted); font-size: var(--t-small); }

  .chat { list-style: none; margin: 0; padding: 0; display: grid; gap: var(--s-5); }
  .chat__msg { display: flex; align-items: flex-end; gap: var(--s-3); will-change: transform, opacity; }
  .chat__msg:nth-child(5) { justify-self: end; flex-direction: row-reverse; }
  .chat__av {
    flex: none;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    border: 1.5px solid rgba(250, 247, 244, 0.16);
    font-family: var(--font-display);
    font-weight: 600;
  }
  .chat__bubble {
    display: grid;
    gap: 2px;
    max-width: 22rem;
    padding: var(--s-3) var(--s-4);
    border-radius: 20px 20px 20px 6px;
    background: var(--surface-2);
    font-size: 1.05rem;
  }
  .chat__msg:nth-child(5) .chat__bubble { border-radius: 20px 20px 6px 20px; }
  .chat__bubble small { color: var(--muted); font-size: 0.8rem; }

  .chat__sys {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr;
    gap: var(--s-4);
    align-items: start;
    padding: var(--s-5) var(--s-5) var(--s-6);
    border-radius: var(--r-l);
    background: linear-gradient(135deg, rgba(255, 106, 26, 0.14), rgba(225, 29, 46, 0.08));
    box-shadow: inset 0 0 0 1px rgba(255, 106, 26, 0.3);
    font-size: clamp(1.1rem, 1rem + 0.5vw, 1.35rem);
    line-height: 1.4;
    will-change: transform, opacity;
  }
  .chat__sys:nth-child(2) { rotate: -1.5deg; }
  .chat__sys:nth-child(4) { rotate: 1.2deg; }
  .chat__sys p { margin: 0; }
  .chat__emoji { font-size: 2.2rem; line-height: 1; }
  .chat__reacts { position: absolute; right: var(--s-5); bottom: -16px; display: flex; gap: var(--s-2); }
  .chat__react {
    padding: 4px 12px;
    border-radius: var(--r-pill);
    background: var(--surface-2);
    box-shadow: 0 0 0 2px var(--ink);
    font-size: 1rem;
    will-change: transform;
  }
  .chat__react b { font-family: var(--font-display); font-weight: 600; font-size: 0.9rem; }

  /* ---------- Trophées ---------- */
  .trophies { margin-top: var(--section-y); }
  .trophies__title {
    margin: 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(1.9rem, 1.1rem + 2.6vw, 3.4rem);
    line-height: 1;
    letter-spacing: -0.025em;
  }
  .trophies__text { margin: var(--s-3) 0 0; color: var(--muted); font-size: var(--t-lead); }
  .trophies__row {
    list-style: none;
    margin: var(--s-7) 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    gap: var(--s-4);
  }
  .trophy { position: relative; display: grid; justify-items: center; gap: var(--s-3); text-align: center; }
  .trophy:nth-child(even) { translate: 0 28px; }
  .trophy::before {
    content: "";
    position: absolute;
    top: 38%;
    left: 50%;
    width: 180%;
    aspect-ratio: 1;
    translate: -50% -50%;
    background: var(--glow-ember);
    opacity: 0.28;
    transition: opacity var(--dur-slow) var(--ease-out);
    pointer-events: none;
  }
  .trophy__tilt { position: relative; width: 100%; max-width: 150px; perspective: 700px; will-change: transform; }
  .trophy__tilt img { width: 100%; height: auto; filter: drop-shadow(0 16px 20px rgba(0, 0, 0, 0.55)); }
  .trophy__name { position: relative; font-family: var(--font-display); font-weight: 600; font-size: 0.95rem; line-height: 1.2; }
  @media (hover: hover) {
    .trophy:hover::before { opacity: 0.7; }
  }

  @media (max-width: 899px) {
    .amb__grid { grid-template-columns: 1fr; gap: var(--s-7); }
    .amb__intro { position: static; }
    .chat__bubble { font-size: 1rem; }
    .chat__sys { padding: var(--s-4) var(--s-4) var(--s-6); gap: var(--s-3); }
    .chat__emoji { font-size: 1.8rem; }
    .trophies__row { grid-template-columns: repeat(4, minmax(0, 1fr)); gap: var(--s-5) var(--s-3); }
    .trophy:nth-child(even) { translate: 0 18px; }
    .trophy__name { font-size: 0.8rem; }
  }
</style>
