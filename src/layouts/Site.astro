---
// Gabarit des pages de la refonte (tokens, Outfit, apparitions, moteur
// d'animation, transitions). Les pages actuelles restent sur Base.astro.
import "../styles/site.css";
import { CONTACT_EMAIL, DISCORD_URL } from "../lib/links";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  // Précharger Outfit : seulement si la page affiche des titres en Outfit
  // au-dessus de la ligne de flottaison.
  preloadFont?: boolean;
  // En-tête posé par-dessus le haut de la page (scène plein écran dès le
  // chargement) au lieu de la pousser vers le bas.
  overlayHeader?: boolean;
  // Partage (Open Graph) : image de 1200 × 630 dans public/.
  ogImage?: string;
  ogTitle?: string;
}
const { title, description, noindex = false, preloadFont = true, overlayHeader = false, ogImage, ogTitle } = Astro.props;
const canonical = new URL(Astro.url.pathname === "/index" ? "/" : Astro.url.pathname, Astro.site);
const ogImageUrl = ogImage && new URL(ogImage, Astro.site).href;
---
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<!-- viewport-fit=cover : sans lui, env(safe-area-inset-*) vaut 0 sur
     iPhone et le pied de page passerait sous la barre de Safari. -->
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>{title}</title>
{description && <meta name="description" content={description}>}
<meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"}>
<meta name="theme-color" content="#08070A">
{!noindex && <link rel="canonical" href={canonical.href}>}
{ogImageUrl && (
  <>
    <meta property="og:type" content="website">
    <meta property="og:locale" content="fr_FR">
    <meta property="og:site_name" content="Braiz">
    <meta property="og:url" content={canonical.href}>
    <meta property="og:title" content={ogTitle ?? title}>
    {description && <meta property="og:description" content={description}>}
    <meta property="og:image" content={ogImageUrl}>
    <meta property="og:image:width" content="1200">
    <meta property="og:image:height" content="630">
    <meta property="og:image:alt" content="Braiz. Règle tes comptes, garde tes potes.">
    <meta name="twitter:card" content="summary_large_image">
  </>
)}
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
{preloadFont && <link rel="preload" href="/fonts/outfit-var-fr.woff2" as="font" type="font/woff2" crossorigin>}
<!-- Avant le premier rendu : les scènes animées choisissent leur mise en
     page (animée ou statique) sans décalage (CLS nul). Sans JavaScript ou
     en reduced-motion, la version statique s'affiche. -->
<script is:inline>
  if (!matchMedia("(prefers-reduced-motion: reduce)").matches) document.documentElement.classList.add("motion-ok");
</script>
</head>
<body>

<header class:list={["site-top", { "site-top--overlay": overlayHeader }]}>
  <div class="wrap">
    <a href="/" aria-label="Braiz, accueil">
      <img class="logo" src="/braiz-wordmark.svg" alt="Braiz" width="104" height="49">
    </a>
  </div>
</header>

<main>
  <slot />
</main>

<footer class="site-bottom">
  <div class="wrap site-bottom__inner">
    <img class="site-bottom__logo" src="/braiz-wordmark.svg" alt="Braiz" width="88" height="41" loading="lazy">
    <nav class="site-bottom__nav" aria-label="Liens du pied de page">
      <a href="/confidentialite">Confidentialité</a>
      <a href="/cgu">Conditions d'utilisation</a>
      <a href="/mentions-legales">Mentions légales</a>
      <a href={`mailto:${CONTACT_EMAIL}`}>{CONTACT_EMAIL}</a>
      {DISCORD_URL && <a href={DISCORD_URL} rel="noopener">Discord</a>}
    </nav>
    <slot name="footer" />
  </div>
</footer>

<script>
  import "../scripts/reveal.ts";
  import "../scripts/motion.ts";
</script>
</body>
</html>
