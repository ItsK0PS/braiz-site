---
// Gabarit des pages de la refonte (tokens, Outfit, apparitions, moteur
// d'animation, transitions). Les pages actuelles restent sur Base.astro.
import "../styles/site.css";

interface Props {
  title: string;
  description?: string;
  noindex?: boolean;
  // Précharger Outfit : seulement si la page affiche des titres en Outfit
  // au-dessus de la ligne de flottaison.
  preloadFont?: boolean;
}
const { title, description, noindex = false, preloadFont = true } = Astro.props;
---
<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{title}</title>
{description && <meta name="description" content={description}>}
<meta name="robots" content={noindex ? "noindex, nofollow" : "index, follow"}>
<meta name="theme-color" content="#08070A">
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
{preloadFont && <link rel="preload" href="/fonts/outfit-var-fr.woff2" as="font" type="font/woff2" crossorigin>}
</head>
<body>

<header class="site-top">
  <div class="wrap">
    <a href="/" aria-label="Braiz, accueil">
      <img class="logo" src="/braiz-wordmark.svg" alt="Braiz" width="104" height="49">
    </a>
  </div>
</header>

<main>
  <slot />
</main>

<footer class="site-bottom">
  <div class="wrap">
    <slot name="footer" />
  </div>
</footer>

<script>
  import "../scripts/reveal.ts";
  import "../scripts/motion.ts";
</script>
</body>
</html>
