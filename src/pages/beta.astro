---
// /beta : transformer un curieux déjà intéressé en testeur. On ne convainc
// plus, on installe.
//
// Invariants :
// - TESTFLIGHT_URL : source unique dans /testflight.js (partagée avec /join) ;
// - #block-android : ancre utilisée par /join ;
// - plateforme détectée dans le <head>, avant le premier rendu (CLS nul) ;
// - sans JavaScript et en reduced-motion : les deux plateformes et toutes
//   les étapes restent visibles et utilisables.
import Site from "../layouts/Site.astro";
import BetaHero from "../components/beta/BetaHero.astro";
import BetaSteps from "../components/beta/BetaSteps.astro";
import BetaMore from "../components/beta/BetaMore.astro";
import { APK_URL } from "../lib/links";
---
<Site
  title="Rejoindre la beta - Braiz"
  description="Rejoins la beta de Braiz sur iPhone ou Android : l'application qui partage les dépenses entre amis et calcule qui doit combien à qui."
  ogTitle="Braiz, la beta"
  ogImage="/og-accueil.png"
>
  <Fragment slot="head">
    <!-- Avant le premier rendu : appareil (is-ios, is-android, is-desktop),
         onglet affiché (show-ios ou show-android) et lien TestFlight public
         (has-testflight). Le CSS décide de tout le reste. /beta#block-android
         (lien depuis /join) ouvre toujours l'onglet Android. -->
    <script is:inline src="/testflight.js"></script>
    <script is:inline>
      (function () {
        var ua = navigator.userAgent;
        var ios = /iPad|iPhone|iPod/.test(ua) || (navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1);
        var android = /Android/i.test(ua);
        var c = document.documentElement.classList;
        c.add(ios ? "is-ios" : android ? "is-android" : "is-desktop");
        c.add(android || location.hash === "#block-android" ? "show-android" : "show-ios");
        c.add(typeof TESTFLIGHT_URL === "string" && TESTFLIGHT_URL ? "has-testflight" : "no-testflight");
      })();
    </script>
  </Fragment>

  <BetaHero />
  <BetaSteps />
  <BetaMore />

  <!-- Barre d'installation, mobile seulement : apparaît une fois le premier
       écran dépassé, disparaît quand les étapes sont à l'écran. -->
  <div class="install-bar" data-install-bar>
    <a class="bbtn bbtn--main" href="#steps-ios" data-platform="ios">Installer sur iPhone</a>
    <a class="bbtn bbtn--main" href={APK_URL} data-platform="android" data-track="Télécharger l'APK" data-track-where="barre">Télécharger pour Android</a>
  </div>
</Site>

<script>
  import "../scripts/beta.ts";
</script>

<style is:global>
  /* ---------- Boutons de /beta ----------
     .bbtn--main : le seul aplat ember de l'écran (dégradé 135° + voile
     28 %). Les autres en contour. */
  .bbtn {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 52px;
    padding: 0 var(--s-6);
    border: 1.5px solid var(--outline);
    border-radius: var(--r-pill);
    background: transparent;
    color: var(--cream);
    font: 600 1rem var(--font-text);
    text-decoration: none;
    -webkit-tap-highlight-color: transparent;
    transition: transform var(--dur-fast) var(--ease-out), box-shadow var(--dur) var(--ease-out);
  }
  .bbtn--main { border-color: transparent; background: var(--gradient-button); }
  .bbtn:disabled { opacity: 0.45; cursor: default; }
  @media (hover: hover) {
    .bbtn:not(:disabled):hover { transform: translate3d(0, -2px, 0); }
  }
  .bbtn:not(:disabled):active { transform: scale(0.97); transition-duration: 80ms; }

  /* Sur ordinateur, le QR code est l'action principale : les boutons du
     premier écran passent en contour. */
  html.is-desktop .bhero .bbtn--main { border-color: var(--outline); background: transparent; }

  /* ---------- Une plateforme à la fois (mode onglets) ----------
     Seulement avec .motion-ok (JavaScript actif, sans reduced-motion) :
     sinon les deux plateformes restent affichées. */
  html.motion-ok.show-ios [data-platform="android"],
  html.motion-ok.show-android [data-platform="ios"] { display: none !important; }

  /* ---------- Barre d'installation (mobile) ---------- */
  .install-bar { display: none; }
  @media (max-width: 899px) {
    html.motion-ok .install-bar {
      position: fixed;
      z-index: 20;
      left: 0;
      right: 0;
      bottom: 0;
      display: grid;
      padding: var(--s-3) var(--gutter) calc(var(--s-3) + env(safe-area-inset-bottom));
      background: linear-gradient(transparent, rgba(8, 7, 10, 0.92) 30%);
      transform: translate3d(0, 110%, 0);
      transition: transform 420ms var(--ease-out);
    }
    html.motion-ok .install-bar.is-shown { transform: none; }
    .install-bar .bbtn { width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .step__check circle, .step__check path { transition: none !important; }
  }
</style>
