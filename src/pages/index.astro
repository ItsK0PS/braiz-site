---
// Accueil (palier P3). Pendant la beta, tous les appels à l'action mènent à
// /beta ; un seul bouton ember par écran.
// Ordre : hero, scène des virements, gratuit, ce que fait Braiz, ambiance
// (chat et trophées), kit de l'organisateur, FAQ, Discord (masqué tant que
// le lien est vide), appel final. Les illustrations de scènes de vie
// viendront plus tard.
import Site from "../layouts/Site.astro";
import Hero from "../components/home/Hero.astro";
import VirementsScene from "../components/virements/VirementsScene.astro";
import Free from "../components/home/Free.astro";
import Features from "../components/home/Features.astro";
import Ambiance from "../components/home/Ambiance.astro";
import Kit from "../components/home/Kit.astro";
import Faq from "../components/home/Faq.astro";
import Discord from "../components/home/Discord.astro";
import FinalCta from "../components/home/FinalCta.astro";
---
<Site
  title="Braiz, l'app pour partager les dépenses entre amis"
  description="Ajoute les dépenses du groupe, Braiz calcule qui doit combien à qui, avec le moins de virements possible. Gratuite, sans pub. Beta ouverte sur iPhone et Android."
  ogTitle="Braiz. Règle tes comptes, garde tes potes."
  ogImage="/og-accueil.png"
>
  <div class="home" data-home data-gsap="split draw">
    <Hero />
    <VirementsScene headingLevel={2} />
    <Free />
    <Features />
    <Ambiance />
    <Kit />
    <Faq />
    <Discord />
    <FinalCta />
  </div>
</Site>

<script>
  import "../scripts/home.ts";
</script>
