---
import Base from "../layouts/Base.astro";
---
<Base>
<Fragment slot="head">
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Invitation - Braiz</title>
<meta name="description" content="Tu as reçu une invitation à rejoindre un groupe sur Braiz.">
<!-- noindex : une page d'invitation porte un jeton, elle n'a rien à faire
     dans un moteur de recherche. Les pages légales, elles, sont indexées. -->
<meta name="robots" content="noindex, nofollow">
<meta name="theme-color" content="#08070A">
<link rel="icon" href="/favicon.ico" sizes="any">
<link rel="apple-touch-icon" href="/apple-touch-icon.png">
<link rel="stylesheet" href="/style.css">
<!-- Avant le premier rendu (CLS nul), comme sur /beta : plateforme
     (is-ios, is-android, is-desktop, has-testflight) et état de la page.
     - jeton mal formé : join-invalid tout de suite, sans requête ;
     - jeton bien formé : join-pending, le temps de la vérification. Le pied
       de page est alors invisible (visibility, sans effet sur la mise en
       page) : il ne bouge jamais sous les yeux quand le résultat arrive.
     Sans JavaScript, aucune classe : « Vérification de l'invitation… »,
     comme avant. Chemin absolu : la page est servie sous /join/<token>. -->
<script is:inline src="/testflight.js"></script>
<script is:inline>
  (function () {
    var ua = navigator.userAgent;
    var ios = /iPad|iPhone|iPod/.test(ua) || (navigator.platform === "MacIntel" && navigator.maxTouchPoints > 1);
    var c = document.documentElement.classList;
    c.add(ios ? "is-ios" : /Android/i.test(ua) ? "is-android" : "is-desktop");
    if (typeof TESTFLIGHT_URL === "string" && TESTFLIGHT_URL) c.add("has-testflight");
    var token = (location.pathname.split("/").filter(Boolean).pop() || "").toLowerCase();
    var uuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
    c.add(uuid.test(token) ? "join-pending" : "join-invalid");
  })();
</script>
</Fragment>

<main>
  <div class="wrap">
    <section class="join" id="join">

      <!-- Trois états mutuellement exclusifs, un seul visible à la fois.
           Ils sont dans le HTML plutôt que construits en JavaScript : le
           texte reste lisible à la source, et rien ne clignote. -->

      <div id="state-loading">
        <p class="join__wait">Vérification de l'invitation…</p>
      </div>

      <div id="state-invalid">
        <h1 class="join__title">Ce lien n'est plus valide.</h1>
        <p class="join__lede">
          Une invitation peut expirer ou avoir déjà été utilisée. Demande un
          nouveau lien à la personne qui te l'a envoyé : cela ne lui prend
          que quelques secondes.
        </p>
        <p class="join__back"><a href="/">Retour à l'accueil</a></p>
      </div>

      <div id="state-ready">
        <h1 class="join__title">Rejoins <span id="group-name"></span> sur Braiz.</h1>
        <p class="join__lede">
          Braiz suit les dépenses d'un groupe d'amis et calcule qui doit
          combien à qui. Tu as reçu une invitation pour rejoindre ce groupe.
        </p>

        <!-- Chemin principal. C'est le cas NORMAL pendant la beta :
             quasiment personne n'a encore l'application. Un seul geste
             d'installation est affiché, choisi selon la plateforme :
             TestFlight sur iPhone, l'APK sur Android, /beta sur ordinateur. -->
        <div class="join__cta">
          <!-- TestFlight d'abord : sans lui, le lien d'installation ne mène
               nulle part. En contour, le geste principal reste Installer Braiz. -->
          <a class="btn btn--outline" id="install-testflight" href="https://apps.apple.com/app/testflight/id899247664">Installer TestFlight</a>
          <a class="btn" id="install-link" href="#">Installer Braiz</a>

          <!-- L'APK directement, sans détour par /beta : le visiteur garde
               cette page ouverte et y revient pour son code une fois
               l'application installée. Les étapes et l'avertissement Play
               Protect restent sur /beta, pour ne pas les écrire deux fois. -->
          <div id="install-android">
            <a class="btn" href="https://github.com/ItsK0PS/braiz-site/releases/latest/download/braiz.apk">Installer Braiz pour Android</a>
            <p class="join__alt">
              Fichier d'environ 155 Mo, une connexion wifi est conseillée.
              Android affichera un avertissement pendant l'installation :
              c'est normal.
              <a href="/beta#block-android">Voir les 3 étapes d'installation</a>.
            </p>
          </div>

          <a class="btn" id="install-desktop" href="/beta">Installer Braiz sur ton téléphone</a>

          <div class="join__soon" id="install-soon">
            <strong>Bientôt disponible sur iPhone.</strong>
            Apple vérifie l'application avant de l'ouvrir aux testeurs.
            Reviens sur ce lien dans quelques jours, ou écris à
            <a href="mailto:contact@getbraiz.com">contact@getbraiz.com</a>
            pour recevoir un message dès l'ouverture.
          </div>

          <p class="join__alt" id="has-app-line">
            <a id="open-app" href="#">J'ai déjà l'application</a>
          </p>
        </div>

        <!-- Le code. Copiable d'un geste : personne ne sélectionne 36
             caractères à la main sur un téléphone. -->
        <h2 class="join__h2">Ton code d'invitation</h2>
        <div class="code">
          <code class="code__value" id="code-value"></code>
          <button class="code__copy" id="code-copy" type="button">Copier</button>
        </div>

        <!-- ⚠️ Le point que les testeurs doivent lire ICI et pas seulement
             dans le message qui les a amenés : un lien ouvert avant d'avoir
             un compte n'est pas mémorisé par l'application. -->
        <h2 class="join__h2">Une fois l'application installée</h2>
        <ol class="steps">
          <li>Ouvre Braiz et <strong>crée ton compte</strong>.</li>
          <li>Sur l'écran d'accueil, touche <strong>Rejoindre un groupe</strong>.</li>
          <li><strong>Colle ton code</strong>, puis valide.</li>
        </ol>

        <div class="join__warn">
          <strong>Garde ton code sous la main.</strong>
          L'application ne retient pas une invitation ouverte avant la
          création de ton compte. Copie le code maintenant, ou reviens sur
          cette page une fois ton compte créé.
        </div>

        <p class="join__desktop" id="desktop-note">
          Braiz s'installe sur iPhone et Android. Ouvre ce lien
          depuis ton téléphone, ou note ton code pour le saisir dans
          l'application une fois installée.
        </p>
      </div>

    </section>
  </div>
</main>

<Fragment slot="after">
<script is:inline>
(function () {
  "use strict";

  // Clé publishable Supabase. Publique par conception : elle ne porte aucune
  // identité, elle sélectionne le rôle anon, et tout son accès est filtré
  // par la RLS. Elle est de toute façon lisible dans le source de cette page
  // par n'importe quel visiteur, la mettre ici ne l'expose pas davantage.
  var SUPABASE_URL = "https://oajskntmzmqmajfuvmny.supabase.co";
  var SUPABASE_KEY = "sb_publishable_jy24W0CwtBD9lrSE1oz2Dw_ZKNkLDJ8";

  var UUID = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;

  // L'état visible est une classe sur <html> (voir le <head> et
  // public/style.css) : join-pending, puis join-ready ou join-invalid.
  function show(id) {
    var c = document.documentElement.classList;
    c.remove("join-pending");
    c.add(id === "state-ready" ? "join-ready" : "join-invalid");
  }

  // Le jeton est le dernier segment du chemin : la réécriture Vercel sert
  // ce fichier pour /join/<token> sans changer l'URL visible.
  var token = (location.pathname.split("/").filter(Boolean).pop() || "").toLowerCase();

  if (!UUID.test(token)) {
    show("state-invalid");
    return;
  }

  // PostgREST directement, sans supabase-js : c'est un POST avec deux
  // en-têtes, charger une bibliothèque pour ça sur un site sans bundler
  // n'apporterait rien. Même RPC que l'application (get_invitation_group),
  // accessible aux anonymes.
  fetch(SUPABASE_URL + "/rest/v1/rpc/get_invitation_group", {
    method: "POST",
    headers: { "apikey": SUPABASE_KEY, "Content-Type": "application/json" },
    body: JSON.stringify({ invitation_token: token })
  })
    .then(function (r) { return r.ok ? r.json() : null; })
    .then(function (rows) {
      if (!rows || !rows.length || !rows[0].group_name) {
        show("state-invalid");
        return;
      }
      render(rows[0].group_name);
    })
    .catch(function () { show("state-invalid"); });

  function render(groupName) {
    // textContent et jamais innerHTML : le nom du groupe est saisi par un
    // utilisateur, il ne doit jamais être interprété comme du balisage.
    document.getElementById("group-name").textContent = "« " + groupName + " »";
    document.getElementById("code-value").textContent = token;
    document.getElementById("open-app").href = "braiz://join/" + token;

    // Les blocs d'installation affichés selon la plateforme sont choisis
    // par le CSS (classes du <head>) ; ici, seulement le lien TestFlight.
    if (TESTFLIGHT_URL) document.getElementById("install-link").href = TESTFLIGHT_URL;

    show("state-ready");
  }

  document.getElementById("code-copy").addEventListener("click", function () {
    var btn = this;
    var done = function () {
      btn.textContent = "Copié";
      btn.classList.add("is-done");
      setTimeout(function () {
        btn.textContent = "Copier";
        btn.classList.remove("is-done");
      }, 2000);
    };

    if (navigator.clipboard && navigator.clipboard.writeText) {
      navigator.clipboard.writeText(token).then(done, selectFallback);
    } else {
      selectFallback();
    }
  });

  // Repli quand l'API presse-papiers est absente ou refusée : on sélectionne
  // le code, il ne reste qu'à valider la copie. Mieux que rien, et surtout
  // mieux que de laisser croire que le bouton a marché.
  function selectFallback() {
    var node = document.getElementById("code-value");
    var range = document.createRange();
    range.selectNodeContents(node);
    var sel = window.getSelection();
    sel.removeAllRanges();
    sel.addRange(range);
  }
})();
</script>
</Fragment>
</Base>
