---
// Seconde page du labo : sert uniquement à juger la transition entre
// pages (@view-transition). noindex, liée seulement depuis /labo.
import Site from "../layouts/Site.astro";
import Button from "../components/Button.astro";
import Glow from "../components/Glow.astro";
---
<Site title="Labo, page 2 - Braiz" description="Seconde page de démonstration, pour la transition entre pages." noindex>
  <section class="hero">
    <Glow size="min(120vw, 800px)" top="45%" left="30%" />
    <div class="wrap hero__inner">
      <p class="eyebrow">Labo P2, page 2</p>
      <h1 class="t-hero t-ember hero__title">La transition entre pages.</h1>
      <p class="t-lead hero__lead">
        Le logo et le titre glissent d'une page à l'autre, le reste apparaît en
        fondu. Aucun script : c'est le navigateur qui s'en charge.
      </p>
      <div class="hero__cta">
        <Button href="/labo" variant="ember">Retour au labo</Button>
      </div>
    </div>
  </section>

  <p slot="footer">Page de démonstration du palier P2, non indexée.</p>
</Site>

<style>
  .hero {
    position: relative;
    min-height: calc(100svh - 100px);
    display: grid;
    align-items: center;
    padding: var(--s-8) 0;
  }
  .hero__inner { position: relative; z-index: 1; }
  .hero__title { max-width: 14ch; view-transition-name: page-title; }
  .hero__lead { max-width: 34rem; margin-top: var(--s-5); }
  .hero__cta { margin-top: var(--s-6); }
</style>
